<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rejectionPane" prefWidth="480.0" styleClass="rejectionParentPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.eodapproval.RejectionController">
   <children>
      <HBox fx:id="rejectionLabelPane" alignment="CENTER_LEFT" spacing="12.0" styleClass="rejectionPageHeader">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="3.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="rejectionPageHeaderLabel" text="%reasonforrejection" />
                  <Label styleClass="rejectionHeaderSubtitle" text="%reject_comment_subtitle" />
               </children>
            </VBox>
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#rejectionWindowExit" styleClass="rejectCommentCloseButton">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </HBox>
      <VBox fx:id="rejectionAnchorPane" spacing="22.0" styleClass="rejectionPaneContent">
         <children>
            <VBox spacing="8.0">
               <children>
                  <Label styleClass="rejectionFieldLabel" text="%reasonforrejection" />
                  <ComboBox fx:id="rejectionComboBox" maxWidth="Infinity" onAction="#rejectionComboboxAction" prefHeight="42.0" prefWidth="432.0" promptText="%select" styleClass="comboboxStyle" visibleRowCount="6">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ComboBox>
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="rejectionButtonBar">
               <children>
                  <Button mnemonicParsing="false" onAction="#rejectionWindowExit" styleClass="rejectionCancelButton" text="%close">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
                  <Button fx:id="rejectionSubmit" mnemonicParsing="false" onAction="#packetUpdateStatus" styleClass="contiuneButton" text="%submit">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
