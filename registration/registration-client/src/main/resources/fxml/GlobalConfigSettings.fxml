<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="configSettingsRoot" prefHeight="600.0" prefWidth="800.0" styleClass="globalConfigPage" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.settings.impl.GlobalConfigSettingsController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="6.0" vgrow="NEVER" />
    <RowConstraints percentHeight="94.0" vgrow="ALWAYS" />
  </rowConstraints>
  <children>
    <!-- Top System Nav Header -->
    <GridPane fx:id="header">
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
      </columnConstraints>
      <rowConstraints>
        <RowConstraints vgrow="ALWAYS" />
      </rowConstraints>
      <children>
        <fx:include fx:id="Header" prefHeight="${header.height}" prefWidth="${header.width}" source="Header.fxml" />
      </children>
    </GridPane>

    <!-- Modern Dashboard Main Content -->
    <VBox spacing="14.0" styleClass="globalConfigMainCard" GridPane.rowIndex="1">
      <padding>
        <Insets top="14.0" bottom="16.0" left="28.0" right="28.0" />
      </padding>
      <children>
        <!-- Header banner with Title, Badge, and Subtitle -->
        <VBox spacing="4.0" styleClass="globalConfigCardHeader">
          <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
              <children>
                <Label fx:id="headerLabel" styleClass="globalConfigTitle" text="Global Config Settings" />
                <Label styleClass="globalConfigBadge" text="SYSTEM CONFIGURATION" />
              </children>
            </HBox>
            <Label styleClass="globalConfigSubtitle" text="%globalConfigDescription" />
          </children>
        </VBox>

        <!-- Search Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="globalConfigToolbar">
          <children>
            <HBox alignment="CENTER_LEFT" maxWidth="460.0" minWidth="280.0" styleClass="globalConfigSearchBox" HBox.hgrow="ALWAYS">
              <children>
                <Label styleClass="globalConfigSearchIcon" text="🔍" />
                <TextField fx:id="filterField" promptText="%searchKey" styleClass="globalConfigSearch" HBox.hgrow="ALWAYS" />
              </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
          </children>
        </HBox>

        <!-- Table Container Card Shell -->
        <ScrollPane fx:id="contentPane" fitToHeight="true" fitToWidth="true" styleClass="globalConfigTableShell" VBox.vgrow="ALWAYS">
          <content>
            <TableView fx:id="globalParamTable" styleClass="globalConfigTable">
              <columns>
                <TableColumn fx:id="key" editable="false" prefWidth="${contentPane.width*44/100}" resizable="false" text="%globalConfigKey" />
                <TableColumn fx:id="serverValue" editable="false" prefWidth="${contentPane.width*28/100}" resizable="false" text="%serverValue" />
                <TableColumn fx:id="localValue" prefWidth="${contentPane.width*27/100}" resizable="false" text="%localValue" />
              </columns>
            </TableView>
          </content>
        </ScrollPane>

        <!-- Footer Action Toolbar -->
        <HBox alignment="CENTER_RIGHT" spacing="16.0" styleClass="globalConfigFooter">
          <children>
            <Label styleClass="globalConfigFooterNote" text="* Edits to local preferences require an application restart." />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#submitPreferences" styleClass="globalConfigSubmitButton" text="%submitPreferences" />
          </children>
        </HBox>
      </children>
    </VBox>
  </children>
</GridPane>
